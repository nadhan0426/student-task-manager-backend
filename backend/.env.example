# Supabase PostgreSQL Configuration (Online Database)
USE_SUPABASE=true
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# MySQL Configuration (Alternative)
USE_MYSQL=false
